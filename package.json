{
  "name": "ourshare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "simulate": "jest tests/simulation --verbose",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:icons": "python scripts/build-app-icons.py",
    "licenses": "expo export --platform android --source-maps --output-dir dist-licenses && node scripts/generate-oss-licenses.mjs dist-licenses",
    "legal:site": "node scripts/build-legal-site.mjs",
    "test:sql": "node --test tests/server/sharing.test.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/unit/**/*.test.ts",
      "**/tests/simulation/**/*.test.ts",
      "**/tests/integration/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "^6.0.3"
  },
  "main": "expo-router/entry"
}
