# Copy to .env.local and fill in. These are shown in the privacy policy and published pages.
# 우리몫 has no server, so there are no keys or secrets to configure.
# Support contact shown in the policy screens (required before any public release)
EXPO_PUBLIC_SUPPORT_EMAIL=
# Person or business named as the privacy contact (required before any public release)
EXPO_PUBLIC_OPERATOR_NAME=
# Sharing (docs/SHARING.md). Public values only: the project URL and the publishable (anon) key.
# NEVER put the service_role key or the database password here. Empty = sharing shown as unavailable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
